# Copy this file to server/.env and replace the placeholder values.
# NEVER commit server/.env to Git.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Database ---
# Local MongoDB:      mongodb://127.0.0.1:27017/campusgig
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/campusgig
MONGODB_URI=mongodb://127.0.0.1:27017/campusgig

# Used ONLY by automated tests. The tests DELETE all data in this database,
# so it must be a different database from MONGODB_URI and its name must contain "test".
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/campusgig_test

# --- Authentication ---
# Generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# --- CORS ---
# The address where the React app runs.
CLIENT_ORIGIN=http://localhost:5173

# --- Client (optional, only for production builds) ---
# In development the Vite proxy is used and this can stay unset.
# VITE_API_URL=https://your-api-domain.example
